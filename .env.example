# Copy to .env and fill in. .env is gitignored, never commit it.

# --- Perception ---
# Tried in order: OpenAI, then OpenRouter, then the scripted stand-in. One
# provider running out of credit degrades fidelity instead of stopping the agent.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Second provider. Worth setting even if OpenAI works, since it is the difference
# between a dead key costing you the demo and costing you nothing.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# --- Discord adapter ---
# Bot token from https://discord.com/developers/applications
# Requires the MESSAGE CONTENT intent to be enabled on the bot.
DISCORD_BOT_TOKEN=
# Comma-separated channel ids the agent should read.
DISCORD_CHANNEL_IDS=

# --- Slack adapter ---
# Socket Mode avoids needing a public HTTPS endpoint. Enable it in the app config.
# Scopes: channels:history, groups:history, users:read
SLACK_BOT_TOKEN=xoxb-
SLACK_APP_TOKEN=xapp-

# --- Voice (optional) ---
# Without this the dashboard speaks through the browser's own speech synthesis,
# which needs no key. With it you get a real voice instead.
ELEVENLABS_API_KEY=
# Defaults to a preset voice, so a key on its own is enough.
ELEVENLABS_VOICE_ID=

# --- Calendar write-back ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# --- Runtime ---
# Local sqlite ledger path.
LEDGER_PATH=./data/ledger.sqlite
# The call rung is a stretch feature. Leave false unless telephony is wired up.
CALL_ENABLED=false
